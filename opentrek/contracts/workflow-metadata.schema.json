{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lutealark.local/schemas/opentrek/workflow-metadata-v1.json",
  "title": "Lutealark OpenTrek workflow metadata v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "workflowVersion", "intent", "strategy", "ragUsed", "sources"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "workflowVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "intent": {
      "enum": ["task_difficulty", "cycle_question", "emotion_support", "daily_checkin", "memory_request", "safety_crisis", "smalltalk"]
    },
    "strategy": {
      "enum": ["none", "task_breakdown", "pomodoro", "environment", "micro_movement", "breathing"]
    },
    "ragUsed": { "type": "boolean" },
    "action": {
      "enum": [
        "offer_breathing", "open_breathing", "offer_focus_timer",
        "open_focus_timer", "open_light_plan", "open_cycle",
        "show_environment_reset", "show_micro_movement",
        "offer_daily_checkin", "open_daily_checkin"
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "source.schema.json" }
    },
    "memoryCandidate": { "$ref": "memory-candidate.schema.json" }
  },
  "if": {
    "properties": { "ragUsed": { "const": true } },
    "required": ["ragUsed"]
  },
  "then": {
    "properties": {
      "sources": { "type": "array", "minItems": 1, "maxItems": 3 }
    }
  },
  "else": {
    "properties": {
      "sources": { "type": "array", "maxItems": 0 }
    }
  }
}
