{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lutealark.local/schemas/opentrek/workflow-input-v1.json",
  "title": "Lutealark OpenTrek workflow input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "input", "currentPhase", "phaseName", "isBufferMode",
    "dayOfCycle", "daysToNextPeriod", "energyValue", "cycleLength",
    "checkinDate", "selfReportedEnergy", "mood", "bodyState",
    "checkinNote", "historyContext"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "input": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "currentPhase": { "type": ["string", "null"], "maxLength": 64 },
    "phaseName": { "type": ["string", "null"], "maxLength": 64 },
    "isBufferMode": { "type": "boolean" },
    "dayOfCycle": { "type": ["integer", "null"], "minimum": 1, "maximum": 35 },
    "daysToNextPeriod": { "type": ["integer", "null"], "minimum": 1, "maximum": 35 },
    "energyValue": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
    "cycleLength": { "type": ["integer", "null"], "minimum": 21, "maximum": 35 },
    "checkinDate": { "type": ["string", "null"], "format": "date" },
    "selfReportedEnergy": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "mood": { "type": ["string", "null"], "maxLength": 40 },
    "bodyState": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 40 } },
    "checkinNote": { "type": "string", "maxLength": 200 },
    "historyContext": { "type": "string", "maxLength": 10000 },
    "savedMemoryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usagePolicy", "items"],
      "properties": {
        "usagePolicy": { "type": "string", "maxLength": 500 },
        "items": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "summary"],
            "properties": {
              "kind": { "enum": ["preference", "constraint", "long_term_goal"] },
              "summary": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        }
      }
    }
  }
}
