# Copy this file to deploy/.env.production and replace the placeholders.
# Run Compose with --env-file deploy/.env.production so substitutions such as
# the database URL and HTTP_PORT use the same values as the containers.

POSTGRES_DB=lutealark
POSTGRES_USER=lutealark
POSTGRES_PASSWORD=replace-me-with-a-long-url-safe-random-value

# The frontend and API are served from one origin by nginx behind Caddy.
VITE_API_BASE_URL=

# Required by deploy/docker-compose.caddy.yml. DNS for this domain must point
# to the server and TCP/UDP ports 80/443 must be reachable from the internet.
LUTEALARK_DOMAIN=app.example.com

HOST=0.0.0.0
PORT=3000
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Keep empty for same-origin web-only deployment. For the bundled Capacitor
# Android app, add the exact WebView origin: CORS_ORIGINS=https://localhost.
# Separate multiple exact origins with commas; never use '*'.
CORS_ORIGINS=

# Public deployment defaults to the local fallback. Keep OpenTrek secrets out
# of this file; set them only in a protected runtime environment when online
# mode is intentionally enabled on a private network.
OPENTREK_MODE=offline
OPENTREK_AGENT_VERSION=1785250561438
OPENTREK_TIMEOUT_MS=10000
OPENTREK_RUN_TIMEOUT_MS=60000
OPENTREK_RETRY_DELAY_MS=250
