# Server
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/lutealark
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Exact comma-separated origins allowed to call the API cross-origin.
# For the bundled Capacitor app, add https://localhost after the HTTPS API is deployed.
CORS_ORIGINS=

# OpenTrek Agent Dev (keep every administrator-provided value only in .env)
# Leave these values empty in offline mode. All four are required in auto/online mode.
OPENTREK_BASE_URL=
OPENTREK_APP_KEY=
OPENTREK_AGENT_CODE=
OPENTREK_AGENT_VERSION=1785250561438
# auto: fall back only on connectivity/5xx; online: fail closed; offline: never call OpenTrek
OPENTREK_MODE=auto
OPENTREK_TIMEOUT_MS=10000
OPENTREK_RUN_TIMEOUT_MS=60000
OPENTREK_RETRY_DELAY_MS=250
